# run locally with `uv run prek run --all-files` (https://prek.j178.dev/)
# hook versions are kept up to date by dependabot (see .github/dependabot.yml)

repos:
  - repo: https://github.com/abravalheri/validate-pyproject
    rev: 0.26
    hooks:
      - id: validate-pyproject

  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.12
    hooks:
      - id: actionlint

  - repo: https://github.com/zizmorcore/zizmor-pre-commit
    rev: v1.30.1
    hooks:
      - id: zizmor
{%- if use_ruff %}

  - repo: https://github.com/adhtruong/mirrors-typos
    rev: v1.50.2
    hooks:
      - id: typos
        args: [--force-exclude]  # omitting --write-changes

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.16.8
    hooks:
      - id: ruff-check
        args: [--fix]  # may also add '--unsafe-fixes'
      - id: ruff-format
        # ruff can also format python code blocks in markdown, but only in preview mode
        types_or: [python, pyi, jupyter]
{%- endif %}
{%- if type_checker == 'ty' %}

  # resolves dependencies from pyproject.toml, no need to duplicate them here
  - repo: https://github.com/astral-sh/ty-pre-commit
    rev: v0.0.83
    hooks:
      - id: ty
{%- elif type_checker == 'mypy' %}

  # runs mypy from the project environment (`uv sync`), so dependencies
  # declared in pyproject.toml are available for type checking
  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: uv run mypy
        language: system
        types_or: [python, pyi]
        pass_filenames: false
        require_serial: true
{%- endif %}
